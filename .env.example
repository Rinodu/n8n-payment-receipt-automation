# Reference only: the program reads environment variables, not this file.
MODE=demo
PROCESSOR_KEYS=
# DATA_KEYS: current Fernet key,previous Fernet key (comma separated).
DATA_KEYS=
# Stable independent fingerprint key; do not rotate it during data-key rotation.
INDEX_KEY=
BIND_HOST=127.0.0.1
PORT=8787
DATA_DIR=data
# Live mode only; fill privately, never commit values.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
RESEND_API_KEY=
EMAIL_FROM=
# Only this exact recipient is allowed in live mode.
TEST_RECIPIENT=
MIDTRANS_SERVER_KEY=
N8N_ENCRYPTION_KEY=
RATE_LIMIT_PER_MINUTE=60
RETENTION_DAYS=30
BACKUP_DAYS=7
# Optional public compose profile:
RECEIPT_DOMAIN=
WEBHOOK_URL=
