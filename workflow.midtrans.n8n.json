{
  "name": "Portfolio - Verified Midtrans Sandbox Receipt",
  "active": false,
  "nodes": [
    {
      "id": "payment-hook",
      "name": "Payment Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "webhookId": "portfolio-midtrans-sandbox-v2",
      "parameters": {
        "httpMethod": "POST",
        "path": "portfolio-midtrans-sandbox",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "receipt-processor",
      "name": "Process Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8787/gateway/midtrans",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "response",
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        780,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      }
    },
    {
      "id": "setup-note",
      "name": "Setup and Safety",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        250,
        60
      ],
      "parameters": {
        "width": 800,
        "height": 190,
        "content": "## Signed Midtrans Sandbox webhook\nPublic ingress has no Header Auth: Midtrans notification is authenticated by its SHA512 signature AND a direct GET status API lookup in the processor.\nInternal HTTP node still REQUIRES X-Processor-Key credential.\nRegister expected orders privately via admin.py before accepting payments.\n200 queued acknowledges durable storage, not email delivery. Sandbox only.\nDocker URL: http://processor:8787/gateway/midtrans."
      }
    }
  ],
  "connections": {
    "Payment Webhook": {
      "main": [
        [
          {
            "node": "Process Receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Receipt": {
      "main": [
        [
          {
            "node": "Return Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
